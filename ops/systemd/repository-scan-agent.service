[Unit]
Description=Read-only server repository inventory agent
Documentation=file:/mnt/repos/homelab-config/docs/runbooks/repository-scan-agent.md
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/mnt/repos/homelab-config
ExecStart=/usr/bin/python3 /mnt/repos/homelab-config/scripts/reporting/scan_repositories.py
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/mnt /srv
ReadWritePaths=/srv/artifacts/hc
UMask=0027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
