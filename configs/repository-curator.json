{
  "schema": "homelab.repository-curator-policy/v1",
  "repositories": [
    {
      "path": "/mnt/repos/homelab-config",
      "mode": "checkpoint-push",
      "remote": "origin",
      "allowed_remote_patterns": [
        "https://github.com/jcasnellie69/homelab-config.git",
        "git@github.com:jcasnellie69/homelab-config.git"
      ],
      "branch_prefix": "repo-health",
      "include_untracked": true,
      "max_file_bytes": 10485760,
      "hard_validations": [],
      "advisory_validations": [
        "PYTHONPYCACHEPREFIX=/tmp/repo-health-pycache python3 -m py_compile scripts/reporting/scan_repositories.py scripts/reporting/curate_repositories.py",
        "ANSIBLE_LOCAL_TEMP=/tmp/ansible-local ANSIBLE_REMOTE_TEMP=/tmp/ansible-remote ansible-lint deploy/ansible/playbooks/disk-remediation.yml deploy/ansible/playbooks/repository-scan-agent.yml"
      ]
    },
    {
      "path": "/mnt/repos/network-inventory",
      "mode": "checkpoint-push",
      "remote": "origin",
      "allowed_remote_patterns": [
        "https://github.com/jcasnellie69/network-inventory.git",
        "git@github.com:jcasnellie69/network-inventory.git"
      ],
      "branch_prefix": "repo-health",
      "include_untracked": true,
      "max_file_bytes": 10485760,
      "hard_validations": [],
      "advisory_validations": []
    }
  ]
}
